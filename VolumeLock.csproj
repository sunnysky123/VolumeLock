<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>VolumeLock</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'x64'">win-x64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' and '$(Platform)' == 'ARM64'">win-arm64</RuntimeIdentifier>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <DefaultLanguage>en-US</DefaultLanguage>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      AudioInterop.Wrap hands raw interface pointers to ComInterfaceMarshaller<T>,
      which only accepts a void*.
    -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!--
    All icon assets are generated by Tools\Generate-Assets.ps1 from Assets\AppIcon.png.
    Include them with wildcards so new sizes/qualifiers never need a manual csproj edit.
    MakePri splits scale / targetsize / altform variants into resource packs at packaging time.
  -->
  <ItemGroup>
    <Content Include="Assets\**\*.png" />
    <Content Include="Assets\**\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix"/>
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK.Runtime" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!--
    Publish Properties

    The default publish is self-contained and trimmed: the .NET runtime is
    bundled inside the MSIX, so there is no "download .NET" prompt and no
    runtime prerequisite for Store users, and ILLink drops the unused parts of
    that runtime. That lands at about 8 MB per architecture, 16 MB for the
    x64 + ARM64 bundle.

    Pass -p:FullRuntime=true (or .\Build-StoreBundle.ps1 -FullRuntime) to ship
    the complete runtime instead: about 45 MB per architecture, 88 MB for the
    bundle. That is the escape hatch for cases where a trimmed build is not an
    option, for example while bisecting a trimming-related failure.

    A framework-dependent package (SelfContained=false) is deliberately not
    offered any more. The Store only auto-installs framework packages listed in
    a <PackageDependency>, and .NET 5+ has no MSIX framework package
    (dotnet/runtime#51574); adding one by hand makes installation fail with
    0x80073CF3. A framework-dependent MSIX would therefore leave users staring
    at a "download .NET" prompt on first launch.

    WindowsAppSDKSelfContained is intentionally left at its default (false) so
    the Windows App SDK stays a Store-serviced framework dependency.

    Trimming and COM: Microsoft documents WinUI 3 as not supporting trimming,
    and trimming this project originally crashed on startup inside
    Microsoft.UI.Xaml.dll with a stowed exception. The cause was not XAML: it
    was audio COM. Trimming makes built-in COM interop unreliable, and legacy
    [ComImport] marshalling is exactly what AudioVolumeService used, so every
    Core Audio call failed or faulted. AudioInterop.cs now declares those
    interfaces with [GeneratedComInterface] / [GeneratedComClass], whose stubs
    are compiled ahead of time and survive trimming.

    Because nothing in this project uses built-in COM any more,
    BuiltInComInteropSupport stays at its default. Setting it to true merely
    re-enables the (unused) ComActivator path and adds an IL2026 trim warning;
    verified that the packaged trimmed build starts and reads volumes with the
    switch both off and on.

    No TrimmerRootAssembly is required: the Windows App SDK projection
    assemblies survive on their own.
  -->
  <PropertyGroup>
    <FullRuntime Condition="'$(FullRuntime)' == ''">false</FullRuntime>
    <!--
      Self-contained is the only shipping mode, so it is pinned here. PublishTrimmed
      is still guarded by '$(SelfContained)' == 'true' rather than being a plain
      true: a command-line -p:SelfContained=false wins over this property, and
      trimming a framework-dependent publish fails with NETSDK1102.
    -->
    <SelfContained>true</SelfContained>
    <!--
      Trimming is a publish-time size optimization, so keep it to Release builds:
      ILLink adds tens of seconds to every build and emits trim analysis warnings
      that would otherwise pollute the daily Debug inner loop.
    -->
    <PublishTrimmed Condition="'$(FullRuntime)' != 'true' and '$(SelfContained)' == 'true' and '$(Configuration)' == 'Release'">true</PublishTrimmed>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <!--
      ReadyToRun would precompile the entire bundled framework, adding about
      36 MB per architecture for a marginal startup gain. Both shipping modes
      bundle the runtime, so it stays off.
    -->
    <PublishReadyToRun>False</PublishReadyToRun>
  </PropertyGroup>

  <!--
    A self-contained publish carries the .NET diagnostic toolchain: createdump,
    the DAC/DBI debugger pair, the DiaSymReader symbol reader, and the EventPipe
    tracing resource modules. A shipping app never touches them, so drop them
    from the publish output (about 7.4 MB per architecture). Verified that the
    app still starts after this removal.
  -->
  <Target Name="RemoveUnneededRuntimeDiagnostics" AfterTargets="Publish" Condition="'$(SelfContained)' == 'true'">
    <ItemGroup>
      <_UnneededRuntimeDiagnostic Include="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))mscordaccore*.dll" />
      <_UnneededRuntimeDiagnostic Include="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))mscordbi.dll" />
      <_UnneededRuntimeDiagnostic Include="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))createdump.exe" />
      <_UnneededRuntimeDiagnostic Include="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))Microsoft.DiaSymReader.Native.*.dll" />
      <_UnneededRuntimeDiagnostic Include="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))clretwrc.dll" />
      <_UnneededRuntimeDiagnostic Include="$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))clrgcexp.dll" />
    </ItemGroup>
    <Delete Files="@(_UnneededRuntimeDiagnostic)" />
  </Target>

  <!--
    The MSIX payload is built from MSBuild items, not by scanning PublishDir, so
    the deletions above do not reach the package. Filter the same files out of
    the payload right before the package is generated.
  -->
  <Target Name="RemoveUnneededRuntimeDiagnosticsFromAppxPayload"
          BeforeTargets="_GenerateAppxPackageFile"
          Condition="'$(SelfContained)' == 'true' and '$(AppxPackage)' == 'true'">
    <ItemGroup>
      <_UnneededRuntimeDiagnosticInPayload Include="@(AppxPackagePayload)"
                                          Condition="$([System.String]::Copy('%(Filename)').StartsWith('mscordaccore')) OR
                                                     '%(Filename)' == 'mscordbi' OR
                                                     '%(Filename)' == 'createdump' OR
                                                     '%(Filename)' == 'clretwrc' OR
                                                     '%(Filename)' == 'clrgcexp' OR
                                                     $([System.String]::Copy('%(Filename)').StartsWith('Microsoft.DiaSymReader.Native'))" />
      <AppxPackagePayload Remove="@(_UnneededRuntimeDiagnosticInPayload)" />
    </ItemGroup>
  </Target>
</Project>